{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-ai.local/schemas/task-v2.json",
  "title": "旅策协同文旅任务 v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "revision", "demo", "evaluationDate", "request", "resources", "facts", "transfers", "plans"],
  "properties": {
    "schemaVersion": {"const": 2},
    "taskId": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 0},
    "demo": {"type": "boolean"},
    "evaluationDate": {"$ref": "#/$defs/date"},
    "request": {"$ref": "#/$defs/request"},
    "resources": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/resource"}},
    "facts": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/fact"}},
    "transfers": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/transfer"}},
    "plans": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/plan"}},
    "migrationWarnings": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}}
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "time": {"type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 80},
    "tri": {"enum": ["yes", "no", "unknown"]},
    "ids": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destinationId", "destination", "startDate", "days", "adults", "children", "seniors", "budget", "maxWalkingMinutes", "weather", "avoidOutdoorInRain", "interests", "dietary", "accessibility", "dayWindows", "requiredNights", "selfArrangedNights", "dietaryRequirements", "accessibilityRequirements", "unresolvedRequirements"],
      "properties": {
        "destinationId": {"$ref": "#/$defs/id"},
        "destination": {"type": "string", "minLength": 1, "maxLength": 200},
        "startDate": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "days": {"type": "integer", "minimum": 1, "maximum": 7},
        "adults": {"type": "integer", "minimum": 0, "maximum": 100},
        "children": {"type": "integer", "minimum": 0, "maximum": 100},
        "seniors": {"type": "integer", "minimum": 0, "maximum": 100},
        "budget": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000000},
        "maxWalkingMinutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "weather": {"enum": ["clear", "rain"]},
        "avoidOutdoorInRain": {"type": "boolean"},
        "interests": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
        "dietary": {"type": "string", "maxLength": 1000},
        "accessibility": {"type": "string", "maxLength": 1000},
        "dayWindows": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/dayWindow"}},
        "requiredNights": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 6}},
        "selfArrangedNights": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 6}},
        "dietaryRequirements": {"type": "object", "additionalProperties": false, "required": ["excludedAllergens", "avoidCrossContact", "dietTypes"], "properties": {"excludedAllergens": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 100}}, "avoidCrossContact": {"type": "boolean"}, "dietTypes": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 100}}}},
        "accessibilityRequirements": {"type": "object", "additionalProperties": false, "required": ["wheelchairRoute", "stepFree", "accessibleRoom", "accessibleVehicle"], "properties": {"wheelchairRoute": {"type": "boolean"}, "stepFree": {"type": "boolean"}, "accessibleRoom": {"type": "boolean"}, "accessibleVehicle": {"type": "boolean"}}},
        "unresolvedRequirements": {"type": "array", "maxItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["text", "reason"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 500}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}}}}
      }
    },
    "dayWindow": {"type": "object", "additionalProperties": false, "required": ["day", "start", "end", "minActivities", "requiredMeals"], "properties": {"day": {"type": "integer", "minimum": 1, "maximum": 7}, "start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}, "minActivities": {"type": "integer", "minimum": 0, "maximum": 20}, "requiredMeals": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["breakfast", "lunch", "dinner"]}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["id", "resourceId", "topic", "text", "sourceLabel", "sourceUrl", "observedAt", "validFrom", "validTo", "status", "demo"], "properties": {"id": {"$ref": "#/$defs/id"}, "resourceId": {"type": ["string", "null"]}, "topic": {"type": "string", "minLength": 1, "maxLength": 100}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}, "sourceLabel": {"type": "string", "minLength": 1, "maxLength": 300}, "sourceUrl": {"type": ["string", "null"], "maxLength": 1000}, "observedAt": {"$ref": "#/$defs/date"}, "validFrom": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "validTo": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "status": {"enum": ["confirmed", "unknown", "conflict"]}, "demo": {"type": "boolean"}}},
    "resource": {"type": "object", "additionalProperties": false, "required": ["id", "destinationId", "areaId", "name", "type", "location", "durationMinutes", "openStart", "openEnd", "indoor", "tags", "priceMode", "adultPrice", "childPrice", "seniorPrice", "unitPrice", "capacityPerSlot", "capacityPerRoom", "accessibleRoomsAvailable", "allergenFree", "crossContactControlled", "dietSupport", "accessibility", "pricingEvidenceIds", "openingEvidenceIds", "capacityEvidenceIds", "suitabilityEvidenceIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "destinationId": {"$ref": "#/$defs/id"}, "areaId": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 500}, "type": {"enum": ["activity", "stay", "meal", "transfer"]}, "location": {"type": "string", "minLength": 1, "maxLength": 500}, "durationMinutes": {"type": "integer", "minimum": 0, "maximum": 1440}, "openStart": {"$ref": "#/$defs/time"}, "openEnd": {"$ref": "#/$defs/time"}, "indoor": {"type": "boolean"}, "tags": {"type": "array", "uniqueItems": true, "maxItems": 30, "items": {"type": "string"}}, "priceMode": {"enum": ["ticket", "per_person", "per_room_night", "fixed"]}, "adultPrice": {"type": ["number", "null"], "minimum": 0}, "childPrice": {"type": ["number", "null"], "minimum": 0}, "seniorPrice": {"type": ["number", "null"], "minimum": 0}, "unitPrice": {"type": ["number", "null"], "minimum": 0}, "capacityPerSlot": {"type": ["integer", "null"], "minimum": 1}, "capacityPerRoom": {"type": ["integer", "null"], "minimum": 1}, "accessibleRoomsAvailable": {"type": ["integer", "null"], "minimum": 0}, "allergenFree": {"$ref": "#/$defs/triMap"}, "crossContactControlled": {"$ref": "#/$defs/triMap"}, "dietSupport": {"$ref": "#/$defs/triMap"}, "accessibility": {"type": "object", "additionalProperties": false, "required": ["wheelchairRoute", "stepFree", "accessibleRoom", "accessibleVehicle"], "properties": {"wheelchairRoute": {"$ref": "#/$defs/tri"}, "stepFree": {"$ref": "#/$defs/tri"}, "accessibleRoom": {"$ref": "#/$defs/tri"}, "accessibleVehicle": {"$ref": "#/$defs/tri"}}}, "pricingEvidenceIds": {"$ref": "#/$defs/ids"}, "openingEvidenceIds": {"$ref": "#/$defs/ids"}, "capacityEvidenceIds": {"$ref": "#/$defs/ids"}, "suitabilityEvidenceIds": {"$ref": "#/$defs/ids"}}},
    "triMap": {"type": "object", "additionalProperties": {"$ref": "#/$defs/tri"}},
    "transfer": {"type": "object", "additionalProperties": false, "required": ["id", "fromResourceId", "toResourceId", "minutes", "walkingMinutes", "costMode", "amount", "serviceResourceId", "evidenceIds"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromResourceId": {"$ref": "#/$defs/id"}, "toResourceId": {"$ref": "#/$defs/id"}, "minutes": {"type": "integer", "minimum": 0, "maximum": 1440}, "walkingMinutes": {"type": "integer", "minimum": 0, "maximum": 1440}, "costMode": {"enum": ["included", "fixed", "per_person", "unknown"]}, "amount": {"type": ["number", "null"], "minimum": 0}, "serviceResourceId": {"type": ["string", "null"]}, "evidenceIds": {"$ref": "#/$defs/ids"}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["itemId", "resourceId", "day", "start", "quantity", "mealSlot"], "properties": {"itemId": {"$ref": "#/$defs/id"}, "resourceId": {"$ref": "#/$defs/id"}, "day": {"type": "integer", "minimum": 1, "maximum": 7}, "start": {"$ref": "#/$defs/time"}, "quantity": {"type": "integer", "minimum": 1, "maximum": 1000}, "mealSlot": {"enum": ["breakfast", "lunch", "dinner", null]}}},
    "stay": {"type": "object", "additionalProperties": false, "required": ["resourceId", "rooms", "checkInDay", "checkInTime", "checkoutDay"], "properties": {"resourceId": {"$ref": "#/$defs/id"}, "rooms": {"type": "integer", "minimum": 1, "maximum": 1000}, "checkInDay": {"type": "integer", "minimum": 1, "maximum": 7}, "checkInTime": {"$ref": "#/$defs/time"}, "checkoutDay": {"type": "integer", "minimum": 2, "maximum": 8}}},
    "plan": {"type": "object", "additionalProperties": false, "required": ["id", "name", "origin", "source", "items", "stays"], "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 500}, "origin": {"enum": ["manual", "generated"]}, "source": {"type": "string", "maxLength": 300}, "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}}, "stays": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/stay"}}}}
  }
}
